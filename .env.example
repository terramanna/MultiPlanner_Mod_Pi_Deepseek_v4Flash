# Copy this file to .env (repo root) and fill in values for this machine.
# .env is gitignored — each machine (server, laptop, ...) keeps its own
# copy with its own local paths. Nothing here needs to match across machines.

# Absolute path to the NSP/Ellipse hybrid_inventory.db on this machine.
# Required for the network overlay (sites + links) to show anything.
MULTIPLANNER_NETWORK_DB_PATH=

# Optional: InfoVista Ellipse GDAL tools directory (Windows only).
# MULTIPLANNER_ELLIPSE_GDAL_DIR=C:\Program Files\InfoVista\Ellipse 9\gdal

# Optional: geocoder settings.
# MULTIPLANNER_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# MULTIPLANNER_GEOCODER_COUNTRYCODES=de
# MULTIPLANNER_GEOCODER_EMAIL=you@example.com
